# `npm run db:up` creates infrastructure/dev/.env with random values, and adds any setting that an
# older file is missing. Never commit that file.
# Use hex only (openssl rand -hex 24) so the values are safe inside SQL and URLs.
GATEMIND_DB_ROOT_PASSWORD=
GATEMIND_DB_APP_PASSWORD=
GATEMIND_DB_MIGRATOR_PASSWORD=
GATEMIND_DB_PORT=3307
# Valkey cache instance (CachePort, RateLimiterPort) and Valkey queue instance (QueuePort).
GATEMIND_CACHE_PASSWORD=
GATEMIND_CACHE_PORT=6380
GATEMIND_QUEUE_PASSWORD=
GATEMIND_QUEUE_PORT=6381
