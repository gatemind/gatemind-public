{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@gatemind/types": ["./libs/shared/types/src/index.ts"],
      "@gatemind/ports": ["./libs/core/ports/src/index.ts"],
      "@gatemind/config": ["./libs/core/config/src/index.ts"],
      "@gatemind/tenancy": ["./libs/core/tenancy/src/index.ts"],
      "@gatemind/database": ["./libs/core/database/src/index.ts"],
      "@gatemind/tenancy-testing": ["./libs/core/tenancy-testing/src/index.ts"],
      "@gatemind/secrets": ["./libs/core/secrets/src/index.ts"],
      "@gatemind/audit": ["./libs/core/audit/src/index.ts"]
    }
  }
}
